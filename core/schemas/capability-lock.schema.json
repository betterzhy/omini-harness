{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-evolution.local/core/schemas/capability-lock.schema.json",
  "type": "object",
  "required": [
    "schemaVersion", "project", "sourceHarnessRevision", "disabledCapabilities",
    "capabilities", "lockFingerprint"
  ],
  "properties": {
    "schemaVersion": {"const": "capability-lock/v1"},
    "project": {"type": "string", "minLength": 1},
    "sourceHarnessRevision": {"type": "string", "pattern": "^content-sha256:[0-9a-f]{64}$"},
    "disabledCapabilities": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "capabilityId", "resolvedVersion", "contentHash", "sourceHarnessRevision",
          "resolvedBecause"
        ],
        "properties": {
          "capabilityId": {"type": "string", "minLength": 1},
          "resolvedVersion": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
          "contentHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "sourceHarnessRevision": {"type": "string", "pattern": "^content-sha256:[0-9a-f]{64}$"},
          "resolvedBecause": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "lockFingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
