{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-evolution.local/core/schemas/capability-lock.schema.json",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schemaVersion", "project", "sourceHarnessRevision", "disabledCapabilities",
        "capabilities", "lockFingerprint"
      ],
      "properties": {
        "schemaVersion": {"const": "capability-lock/v1"},
        "project": {"type": "string", "minLength": 1},
        "sourceHarnessRevision": {"type": "string", "pattern": "^content-sha256:[0-9a-f]{64}$"},
        "disabledCapabilities": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "capabilityId", "resolvedVersion", "contentHash", "sourceHarnessRevision",
              "resolvedBecause"
            ],
            "properties": {
              "capabilityId": {"type": "string", "minLength": 1},
              "resolvedVersion": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
              "contentHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "sourceHarnessRevision": {"type": "string", "pattern": "^content-sha256:[0-9a-f]{64}$"},
              "resolvedBecause": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1},
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        },
        "lockFingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schemaVersion", "project", "sourceHarnessRevision", "disabledCapabilities",
        "capabilities", "lockFingerprint"
      ],
      "properties": {
        "schemaVersion": {"const": "capability-lock/v2"},
        "project": {"type": "string", "minLength": 1},
        "sourceHarnessRevision": {"type": "string", "pattern": "^content-sha256:[0-9a-f]{64}$"},
        "disabledCapabilities": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "capabilityId", "resolvedVersion", "contentHash", "sourceHarnessRevision",
                  "resolvedBecause", "sourceKind"
                ],
                "properties": {
                  "capabilityId": {"type": "string", "minLength": 1},
                  "resolvedVersion": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
                  "contentHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "sourceHarnessRevision": {"type": "string", "pattern": "^content-sha256:[0-9a-f]{64}$"},
                  "resolvedBecause": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1},
                    "uniqueItems": true
                  },
                  "sourceKind": {"const": "HARNESS_CANONICAL"}
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "capabilityId", "resolvedVersion", "contentHash", "sourceHarnessRevision",
                  "resolvedBecause", "sourceKind", "sourceRegistrationId", "sourceCommit",
                  "sourceTree", "resolvedContentDigest", "validatorIdentity",
                  "registrationFingerprint"
                ],
                "properties": {
                  "capabilityId": {"type": "string", "minLength": 1},
                  "resolvedVersion": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
                  "contentHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "sourceHarnessRevision": {"type": "string", "pattern": "^content-sha256:[0-9a-f]{64}$"},
                  "resolvedBecause": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1},
                    "uniqueItems": true
                  },
                  "sourceKind": {"const": "EXTERNAL_CAPABILITY_PACK"},
                  "sourceRegistrationId": {
                    "type": "string",
                    "pattern": "^pack:[a-z0-9][a-z0-9._-]*$"
                  },
                  "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                  "sourceTree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                  "resolvedContentDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                  "validatorIdentity": {
                    "type": "object",
                    "required": ["relativePath", "sha256"],
                    "properties": {
                      "relativePath": {"const": "scripts/verify-capability-pack"},
                      "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                      "environmentContract": {
                        "enum": ["SANITIZED", "REGISTERED_TOOLCHAIN_OFFLINE_CACHE", "MANAGED_TOOLCHAIN_PROFILE"]
                      },
                      "gitHistoryContract": {
                        "enum": ["CANDIDATE_ONLY", "CANDIDATE_PARENT_TREE"]
                      },
                      "timeoutSeconds": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1800
                      },
                      "toolchain": {
                        "type": "object",
                        "required": ["ruby", "rg", "java", "javac", "mvn", "javaHome", "mavenHome", "mavenRepository"],
                        "properties": {
                          "ruby": {"$ref": "#/$defs/toolIdentity"},
                          "rg": {"$ref": "#/$defs/toolIdentity"},
                          "java": {"$ref": "#/$defs/toolIdentity"},
                          "javac": {"$ref": "#/$defs/toolIdentity"},
                          "mvn": {"$ref": "#/$defs/toolIdentity"},
                          "javaHome": {"$ref": "#/$defs/directoryIdentity"},
                          "mavenHome": {"$ref": "#/$defs/directoryIdentity"},
                          "mavenRepository": {"$ref": "#/$defs/directoryIdentity"}
                        },
                        "additionalProperties": false
                      },
                      "toolchainProfile": {
                        "$ref": "#/$defs/toolchainProfileIdentity"
                      }
                    },
                    "additionalProperties": false,
                    "allOf": [
                      {
                        "if": {
                          "required": ["environmentContract"],
                          "properties": {
                            "environmentContract": {
                              "const": "REGISTERED_TOOLCHAIN_OFFLINE_CACHE"
                            }
                          }
                        },
                        "then": {
                          "required": ["toolchain"],
                          "not": {"required": ["toolchainProfile"]}
                        }
                      },
                      {
                        "if": {
                          "required": ["environmentContract"],
                          "properties": {
                            "environmentContract": {
                              "const": "MANAGED_TOOLCHAIN_PROFILE"
                            }
                          }
                        },
                        "then": {
                          "required": ["toolchainProfile"],
                          "not": {"required": ["toolchain"]}
                        }
                      },
                      {
                        "if": {"required": ["toolchainProfile"]},
                        "then": {
                          "required": ["environmentContract"],
                          "properties": {
                            "environmentContract": {
                              "const": "MANAGED_TOOLCHAIN_PROFILE"
                            }
                          }
                        }
                      }
                    ],
                    "oneOf": [
                      {
                        "required": ["toolchain"],
                        "not": {"required": ["toolchainProfile"]}
                      },
                      {
                        "required": ["toolchainProfile"],
                        "not": {"required": ["toolchain"]}
                      },
                      {
                        "not": {
                          "anyOf": [
                            {"required": ["toolchain"]},
                            {"required": ["toolchainProfile"]}
                          ]
                        }
                      }
                    ]
                  },
                  "registrationFingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
                },
                "additionalProperties": false
              }
            ]
          },
          "contains": {
            "type": "object",
            "required": ["sourceKind"],
            "properties": {
              "sourceKind": {"const": "EXTERNAL_CAPABILITY_PACK"}
            }
          },
          "minContains": 1
        },
        "lockFingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "toolIdentity": {
      "type": "object",
      "required": ["absolutePath", "sha256"],
      "properties": {
        "absolutePath": {"type": "string", "pattern": "^/(?:[^/]+/)*[^/]+$"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "directoryIdentity": {
      "type": "object",
      "required": ["absolutePath", "sha256"],
      "properties": {
        "absolutePath": {"type": "string", "pattern": "^/(?:[^/]+/)*[^/]+$"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "toolchainProfileIdentity": {
      "type": "object",
      "required": ["profileId", "profileDigest"],
      "properties": {
        "profileId": {
          "type": "string",
          "pattern": "^toolchain-profile:[a-z0-9._:-]+$"
        },
        "profileDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  }
}
