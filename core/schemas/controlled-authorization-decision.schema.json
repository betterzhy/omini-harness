{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://agent-evolution.local/core/schemas/controlled-authorization-decision.schema.json",
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "reasonCode": {"enum": ["SAME_OWNER", "FACT_FAMILY_OVERLAP", "BINDING_OVERLAP", "EXACT_WRITESET_OVERLAP", "EPHEMERAL_WRITESET_OVERLAP", "SHARED_ARTIFACT_OVERLAP", "AUTHORITY_INPUT_WRITE", "DEPENDENCY_PATH", "PRODUCER_CONSUMER_PATH", "PUBLIC_CONTRACT_SERIAL_BARRIER", "MIGRATION_SERIAL_BARRIER", "GLOBAL_SHARED_ARTIFACT_BARRIER", "ENVELOPE_NOT_YET_VALID", "ENVELOPE_EXPIRED", "PORTFOLIO_NOT_PERMITTED", "DELIVERY_TRACK_NOT_PERMITTED", "SLICE_CLASS_NOT_PERMITTED", "ACTION_CLASS_NOT_PERMITTED", "ACTION_EXPLICITLY_DENIED", "WRITESET_OUTSIDE_PREFIX", "SLICE_NOT_READY", "UNKNOWN_DEPENDENCY", "DEPENDENCY_CYCLE", "DEPENDENCY_NOT_CLOSED", "CONFLICT_CLUSTER_BUSY", "PROJECT_CAPACITY_LIMIT"]}, "outputEntry": {"type": "object", "required": ["sliceId", "result", "reasons"], "properties": {"sliceId": {"$ref": "#/$defs/id"}, "result": {"enum": ["ALLOW", "REJECT"]}, "reasons": {"type": "array", "items": {"$ref": "#/$defs/reasonCode"}, "uniqueItems": true}}, "additionalProperties": false}},
  "type": "object", "required": ["schemaVersion", "projectId", "authoritySnapshotFingerprint", "envelopeId", "envelopeDigest", "asOf", "decisions", "gate", "authorizationDecisionId"],
  "properties": {"schemaVersion": {"const": "controlled-authorization-decision/v1"}, "projectId": {"type": "string", "minLength": 1}, "authoritySnapshotFingerprint": {"$ref": "#/$defs/digest"}, "envelopeId": {"$ref": "#/$defs/id"}, "envelopeDigest": {"$ref": "#/$defs/digest"}, "asOf": {"type": "string", "minLength": 1}, "decisions": {"type": "array", "items": {"$ref": "#/$defs/outputEntry"}, "uniqueItems": true}, "gate": {"enum": ["PASS", "NO_GO"]}, "authorizationDecisionId": {"type": "string", "pattern": "^authorization-decision:[0-9a-f]{24}$"}}, "additionalProperties": false
}
