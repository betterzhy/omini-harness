{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://agent-evolution.local/core/schemas/controlled-conflict-report.schema.json",
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "path": {"type": "string", "minLength": 1}, "stringSet": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "reasonCode": {"enum": ["SAME_OWNER", "FACT_FAMILY_OVERLAP", "BINDING_OVERLAP", "EXACT_WRITESET_OVERLAP", "EPHEMERAL_WRITESET_OVERLAP", "SHARED_ARTIFACT_OVERLAP", "AUTHORITY_INPUT_WRITE", "DEPENDENCY_PATH", "PRODUCER_CONSUMER_PATH", "PUBLIC_CONTRACT_SERIAL_BARRIER", "MIGRATION_SERIAL_BARRIER", "GLOBAL_SHARED_ARTIFACT_BARRIER", "ENVELOPE_NOT_YET_VALID", "ENVELOPE_EXPIRED", "PORTFOLIO_NOT_PERMITTED", "DELIVERY_TRACK_NOT_PERMITTED", "SLICE_CLASS_NOT_PERMITTED", "ACTION_CLASS_NOT_PERMITTED", "ACTION_EXPLICITLY_DENIED", "WRITESET_OUTSIDE_PREFIX", "SLICE_NOT_READY", "UNKNOWN_DEPENDENCY", "DEPENDENCY_CYCLE", "DEPENDENCY_NOT_CLOSED", "CONFLICT_CLUSTER_BUSY", "PROJECT_CAPACITY_LIMIT"]},
    "producerConsumer": {"type": "object", "required": ["producer", "consumer"], "properties": {"producer": {"$ref": "#/$defs/id"}, "consumer": {"$ref": "#/$defs/id"}}, "additionalProperties": false},
    "footprint": {"type": "object", "required": ["sliceId", "ownerSet", "factFamilySet", "publicContractSet", "producerConsumerSet", "bindingSet", "exactWriteSet", "ephemeralWriteSet", "sharedArtifactSet", "dependencySet", "migrationResourceSet", "authorityReferences", "conflictFootprintId"], "properties": {"sliceId": {"$ref": "#/$defs/id"}, "ownerSet": {"$ref": "#/$defs/stringSet"}, "factFamilySet": {"$ref": "#/$defs/stringSet"}, "publicContractSet": {"$ref": "#/$defs/stringSet"}, "producerConsumerSet": {"type": "array", "items": {"$ref": "#/$defs/producerConsumer"}, "uniqueItems": true}, "bindingSet": {"$ref": "#/$defs/stringSet"}, "exactWriteSet": {"type": "array", "items": {"$ref": "#/$defs/path"}, "uniqueItems": true}, "ephemeralWriteSet": {"type": "array", "items": {"$ref": "#/$defs/path"}, "uniqueItems": true}, "sharedArtifactSet": {"$ref": "#/$defs/stringSet"}, "dependencySet": {"$ref": "#/$defs/stringSet"}, "migrationResourceSet": {"$ref": "#/$defs/stringSet"}, "authorityReferences": {"type": "array", "items": {"$ref": "#/$defs/path"}, "uniqueItems": true}, "conflictFootprintId": {"type": "string", "pattern": "^footprint:[0-9a-f]{24}$"}}, "additionalProperties": false},
    "edge": {"type": "object", "required": ["leftSliceId", "rightSliceId", "reasons"], "properties": {"leftSliceId": {"$ref": "#/$defs/id"}, "rightSliceId": {"$ref": "#/$defs/id"}, "reasons": {"type": "array", "items": {"$ref": "#/$defs/reasonCode"}, "uniqueItems": true}}, "additionalProperties": false},
    "cluster": {"type": "object", "required": ["clusterId", "sliceIds"], "properties": {"clusterId": {"type": "string", "pattern": "^conflict-cluster:[0-9a-f]{24}$"}, "sliceIds": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}}, "additionalProperties": false}
  },
  "type": "object", "required": ["schemaVersion", "projectId", "authoritySnapshotFingerprint", "conflictPolicyVersion", "footprints", "edges", "clusters", "conflictReportId"],
  "properties": {"schemaVersion": {"const": "controlled-conflict-report/v1"}, "projectId": {"$ref": "#/$defs/id"}, "authoritySnapshotFingerprint": {"$ref": "#/$defs/digest"}, "conflictPolicyVersion": {"const": "controlled-conflict-policy/v1"}, "footprints": {"type": "array", "items": {"$ref": "#/$defs/footprint"}, "uniqueItems": true}, "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}, "uniqueItems": true}, "clusters": {"type": "array", "items": {"$ref": "#/$defs/cluster"}, "uniqueItems": true}, "conflictReportId": {"type": "string", "pattern": "^conflict-report:[0-9a-f]{24}$"}}, "additionalProperties": false
}
