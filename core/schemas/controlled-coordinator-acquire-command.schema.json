{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-evolution.local/core/schemas/controlled-coordinator-acquire-command.schema.json",
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "gitObject": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "absolutePath": {"type": "string", "pattern": "^/[^\\u0000]*$", "minLength": 2},
    "admissionBinding": {
      "type": "object",
      "required": ["projectId", "sliceId", "attemptId", "originalSourceRoot", "laneRoot"],
      "properties": {
        "projectId": {"$ref": "#/$defs/id"},
        "sliceId": {"$ref": "#/$defs/id"},
        "attemptId": {"$ref": "#/$defs/id"},
        "originalSourceRoot": {"$ref": "#/$defs/absolutePath"},
        "laneRoot": {"$ref": "#/$defs/absolutePath"}
      },
      "additionalProperties": false
    },
    "admissionAuthorityProof": {
      "type": "object",
      "required": ["factId", "manifestAuthorityId", "manifestAuthorityReference", "manifestAuthorityDigest", "binding", "proofDigest"],
      "properties": {
        "factId": {"type": "string", "pattern": "^controlled_coordination\\.admission\\.[a-z0-9][a-z0-9._:-]*$"},
        "manifestAuthorityId": {"$ref": "#/$defs/id"},
        "manifestAuthorityReference": {"type": "string", "minLength": 1},
        "manifestAuthorityDigest": {"$ref": "#/$defs/digest"},
        "binding": {"$ref": "#/$defs/admissionBinding"},
        "proofDigest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schemaVersion", "projectId", "batchPlanId", "sliceId", "attemptId",
    "authoritySnapshotFingerprint", "authorizationEnvelopeDigest",
    "conflictPolicyVersion", "asOf", "planningRequest", "executionPlan", "sliceDescriptor",
    "authorizationEnvelope", "authoritySnapshot", "admissionAuthorityProof", "fullFootprint",
    "originalSourceRoot", "laneRoot", "expectedLaneBase", "commandDigest"
  ],
  "properties": {
    "schemaVersion": {"const": "controlled-coordinator-acquire-command/v1"},
    "projectId": {"$ref": "#/$defs/id"},
    "batchPlanId": {"type": "string", "pattern": "^batch-plan:[0-9a-f]{24}$"},
    "sliceId": {"$ref": "#/$defs/id"},
    "attemptId": {"$ref": "#/$defs/id"},
    "authoritySnapshotFingerprint": {"$ref": "#/$defs/digest"},
    "authorizationEnvelopeDigest": {"$ref": "#/$defs/digest"},
    "conflictPolicyVersion": {"const": "controlled-conflict-policy/v1"},
    "asOf": {"type": "string", "minLength": 1},
    "planningRequest": {"$ref": "https://agent-evolution.local/core/schemas/controlled-planning-request.schema.json"},
    "executionPlan": {"$ref": "https://agent-evolution.local/core/schemas/controlled-execution-plan.schema.json"},
    "sliceDescriptor": {"$ref": "https://agent-evolution.local/core/schemas/controlled-slice-descriptor.schema.json"},
    "authorizationEnvelope": {"$ref": "https://agent-evolution.local/core/schemas/controlled-authorization-envelope.schema.json"},
    "authoritySnapshot": {"$ref": "https://agent-evolution.local/core/schemas/authority-snapshot.schema.json"},
    "admissionAuthorityProof": {"$ref": "#/$defs/admissionAuthorityProof"},
    "fullFootprint": {"$ref": "https://agent-evolution.local/core/schemas/controlled-conflict-report.schema.json#/$defs/footprint"},
    "originalSourceRoot": {"$ref": "#/$defs/absolutePath"},
    "laneRoot": {"$ref": "#/$defs/absolutePath"},
    "expectedLaneBase": {"$ref": "#/$defs/gitObject"},
    "commandDigest": {"$ref": "#/$defs/digest"}
  },
  "additionalProperties": false
}
