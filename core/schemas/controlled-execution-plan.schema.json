{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://agent-evolution.local/core/schemas/controlled-execution-plan.schema.json",
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "reasonCode": {"enum": ["SAME_OWNER", "FACT_FAMILY_OVERLAP", "BINDING_OVERLAP", "EXACT_WRITESET_OVERLAP", "EPHEMERAL_WRITESET_OVERLAP", "SHARED_ARTIFACT_OVERLAP", "AUTHORITY_INPUT_WRITE", "DEPENDENCY_PATH", "PRODUCER_CONSUMER_PATH", "PUBLIC_CONTRACT_SERIAL_BARRIER", "MIGRATION_SERIAL_BARRIER", "GLOBAL_SHARED_ARTIFACT_BARRIER", "ENVELOPE_NOT_YET_VALID", "ENVELOPE_EXPIRED", "PORTFOLIO_NOT_PERMITTED", "DELIVERY_TRACK_NOT_PERMITTED", "SLICE_CLASS_NOT_PERMITTED", "ACTION_CLASS_NOT_PERMITTED", "ACTION_EXPLICITLY_DENIED", "WRITESET_OUTSIDE_PREFIX", "SLICE_NOT_READY", "UNKNOWN_DEPENDENCY", "DEPENDENCY_CYCLE", "DEPENDENCY_NOT_CLOSED", "CONFLICT_CLUSTER_BUSY", "PROJECT_CAPACITY_LIMIT"]}, "reviewPolicy": {"type": "object", "required": ["reviewerRole", "minimumVerdict"], "properties": {"reviewerRole": {"type": "string", "minLength": 1}, "minimumVerdict": {"const": "GO_ZERO_FINDINGS"}}, "additionalProperties": false}, "outputEntry": {"type": "object", "required": ["sliceId", "reasons"], "properties": {"sliceId": {"$ref": "#/$defs/id"}, "reasons": {"type": "array", "items": {"$ref": "#/$defs/reasonCode"}, "uniqueItems": true}}, "additionalProperties": false}, "proposedEntry": {"type": "object", "required": ["sliceId", "conflictClusterId", "descriptorDigest", "exactWriteSetDigest"], "properties": {"sliceId": {"$ref": "#/$defs/id"}, "conflictClusterId": {"type": "string", "pattern": "^conflict-cluster:[0-9a-f]{24}$"}, "descriptorDigest": {"$ref": "#/$defs/digest"}, "exactWriteSetDigest": {"$ref": "#/$defs/digest"}}, "additionalProperties": false}},
  "type": "object", "required": ["schemaVersion", "projectId", "batchBaseCommit", "authoritySnapshotFingerprint", "contractRegistryDigest", "dependencyGraphDigest", "authorizationEnvelopeDigest", "conflictPolicyVersion", "harnessVersion", "asOf", "conflictReportId", "authorizationDecisionId", "provisional", "requiresCoordinatorRecheck", "projectLaneCap", "proposedAdmissions", "queued", "blocked", "rejected", "executionRequirements", "mandatoryStopConditions", "batchPlanId"],
  "properties": {"schemaVersion": {"const": "controlled-execution-plan/v1"}, "projectId": {"$ref": "#/$defs/id"}, "batchBaseCommit": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"}, "authoritySnapshotFingerprint": {"$ref": "#/$defs/digest"}, "contractRegistryDigest": {"$ref": "#/$defs/digest"}, "dependencyGraphDigest": {"$ref": "#/$defs/digest"}, "authorizationEnvelopeDigest": {"$ref": "#/$defs/digest"}, "conflictPolicyVersion": {"const": "controlled-conflict-policy/v1"}, "harnessVersion": {"const": "agent-evolution-harness/0.1.0"}, "asOf": {"type": "string", "minLength": 1}, "conflictReportId": {"type": "string", "pattern": "^conflict-report:[0-9a-f]{24}$"}, "authorizationDecisionId": {"type": "string", "pattern": "^authorization-decision:[0-9a-f]{24}$"}, "provisional": {"const": true}, "requiresCoordinatorRecheck": {"const": true}, "projectLaneCap": {"type": "integer", "minimum": 1, "maximum": 3}, "proposedAdmissions": {"type": "array", "items": {"$ref": "#/$defs/proposedEntry"}, "uniqueItems": true}, "queued": {"type": "array", "items": {"$ref": "#/$defs/outputEntry"}, "uniqueItems": true}, "blocked": {"type": "array", "items": {"$ref": "#/$defs/outputEntry"}, "uniqueItems": true}, "rejected": {"type": "array", "items": {"$ref": "#/$defs/outputEntry"}, "uniqueItems": true}, "executionRequirements": {"type": "object", "required": ["requiredTests", "requiredGates", "requiredReviewers", "minimumReviewVerdict", "sliceRequirements"], "properties": {"requiredTests": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "requiredGates": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "requiredReviewers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "minimumReviewVerdict": {"const": "GO_ZERO_FINDINGS"}, "sliceRequirements": {"type": "array", "items": {"type": "object", "required": ["sliceId", "requiredGates", "reviewPolicy"], "properties": {"sliceId": {"$ref": "#/$defs/id"}, "requiredGates": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "reviewPolicy": {"$ref": "#/$defs/reviewPolicy"}}, "additionalProperties": false}, "uniqueItems": true}}, "additionalProperties": false}, "mandatoryStopConditions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "batchPlanId": {"type": "string", "pattern": "^batch-plan:[0-9a-f]{24}$"}}, "additionalProperties": false
}
