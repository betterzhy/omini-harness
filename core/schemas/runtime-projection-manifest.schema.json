{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-evolution.local/core/schemas/runtime-projection-manifest.schema.json",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validatorIdentity": {
      "type": "object",
      "required": ["relativePath", "sha256"],
      "properties": {
        "relativePath": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "environmentContract": {
          "enum": ["SANITIZED", "REGISTERED_TOOLCHAIN_OFFLINE_CACHE"]
        },
        "gitHistoryContract": {
          "enum": ["CANDIDATE_ONLY", "CANDIDATE_PARENT_TREE"]
        },
        "toolchain": {
          "type": "object",
          "required": ["ruby", "rg", "java"],
          "properties": {
            "ruby": {"$ref": "#/$defs/toolIdentity"},
            "rg": {"$ref": "#/$defs/toolIdentity"},
            "java": {"$ref": "#/$defs/toolIdentity"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "toolIdentity": {
      "type": "object",
      "required": ["absolutePath", "sha256"],
      "properties": {
        "absolutePath": {"type": "string", "pattern": "^/(?:[^/]+/)*[^/]+$"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "internalSourceCapability": {
      "type": "object",
      "required": ["id", "kind", "version", "contentHash"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["PRINCIPLE", "FRAMEWORK", "SKILL", "WORKFLOW"]},
        "version": {"type": "string", "minLength": 1},
        "contentHash": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "externalSourceCapability": {
      "type": "object",
      "required": [
        "id", "kind", "version", "contentHash", "sourceKind", "sourceRegistrationId",
        "sourceCommit", "sourceTree", "resolvedContentDigest", "validatorIdentity",
        "registrationFingerprint"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["PRINCIPLE", "FRAMEWORK", "SKILL", "WORKFLOW"]},
        "version": {"type": "string", "minLength": 1},
        "contentHash": {"$ref": "#/$defs/sha256"},
        "sourceKind": {"const": "EXTERNAL_CAPABILITY_PACK"},
        "sourceRegistrationId": {"type": "string", "minLength": 1},
        "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "sourceTree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "resolvedContentDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "validatorIdentity": {"$ref": "#/$defs/validatorIdentity"},
        "registrationFingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "sourceCapability": {
      "oneOf": [
        {"$ref": "#/$defs/internalSourceCapability"},
        {"$ref": "#/$defs/externalSourceCapability"}
      ]
    },
    "internalGeneratedSkill": {
      "type": "object",
      "required": ["id", "version", "contentHash", "skillProjectionVersion", "path"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "contentHash": {"$ref": "#/$defs/sha256"},
        "skillProjectionVersion": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^skills/[^/]+/SKILL\\.md$"}
      },
      "additionalProperties": false
    },
    "externalGeneratedSkill": {
      "type": "object",
      "required": [
        "id", "version", "contentHash", "skillProjectionVersion", "path", "sourceKind",
        "sourceRegistrationId", "sourceCommit", "sourceTree", "resolvedContentDigest",
        "validatorIdentity", "registrationFingerprint", "sourceSkillPath", "skillBlobSha256"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "contentHash": {"$ref": "#/$defs/sha256"},
        "skillProjectionVersion": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^skills/[^/]+/SKILL\\.md$"},
        "sourceKind": {"const": "EXTERNAL_CAPABILITY_PACK"},
        "sourceRegistrationId": {"type": "string", "minLength": 1},
        "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "sourceTree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "resolvedContentDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "validatorIdentity": {"$ref": "#/$defs/validatorIdentity"},
        "registrationFingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "sourceSkillPath": {"type": "string", "minLength": 1},
        "skillBlobSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schemaVersion", "projectionType", "projectionVersion", "runtime", "project",
    "sourceResolutionId", "capabilityLockFingerprint", "projectStateHash",
    "projectBindingHash", "sourceCapabilities", "generatedSkills", "omittedReferences",
    "generatedFiles"
  ],
  "properties": {
    "schemaVersion": {"const": "runtime-projection-manifest/v1"},
    "projectionType": {"enum": ["CHATGPT_PROJECT_PACK", "CODEX_REPOSITORY_PACK"]},
    "projectionVersion": {"type": "string", "minLength": 1},
    "runtime": {"enum": ["CHATGPT", "CODEX"]},
    "project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "sourceResolutionId": {"type": "string", "minLength": 1},
    "capabilityLockFingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "projectStateHash": {"$ref": "#/$defs/sha256"},
    "projectBindingHash": {"$ref": "#/$defs/sha256"},
    "sourceCapabilities": {"type": "array", "items": {"$ref": "#/$defs/sourceCapability"}},
    "generatedSkills": {
      "type": "array",
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/internalGeneratedSkill"},
          {"$ref": "#/$defs/externalGeneratedSkill"}
        ]
      }
    },
    "omittedReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "reason"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "generatedFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        },
        "additionalProperties": false
      }
    },
    "authoritySnapshotFingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "authoritySourceRevision": {
      "type": "object",
      "required": ["kind", "head", "tree", "authoritySetStatus", "authoritySetDigest"],
      "properties": {
        "kind": {"enum": ["GIT", "CONTENT"]},
        "head": {"type": "string", "minLength": 1},
        "tree": {"type": "string", "minLength": 1},
        "authoritySetStatus": {"enum": ["CLEAN_FOR_AUTHORITY_SET", "DIRTY_AUTHORITY_SET", "CONTENT_SNAPSHOT"]},
        "authoritySetDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "authorityGate": {"enum": ["PASS", "NO_GO"]}
  },
  "additionalProperties": false
}
