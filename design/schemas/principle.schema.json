{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-evolution.local/design/schemas/principle.schema.json",
  "allOf": [
    {"$ref": "https://agent-evolution.local/core/schemas/common-capability.schema.json"},
    {
      "type": "object",
      "properties": {
        "kind": {"const": "PRINCIPLE"},
        "principle": {
          "type": "object",
          "required": ["invariant"],
          "properties": {
            "invariant": {"type": "string", "minLength": 1},
            "exceptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "negativeExamples": {"type": "array", "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": false
        }
      },
      "required": ["principle"]
    }
  ],
  "unevaluatedProperties": false
}
