{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://java-spec.local/schemas/code-quality.schema.json",
  "title": "Java 代码质量机器配置",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "standardIdentity", "mode", "reactorModules", "sourceLayoutVerifier", "qualityRunnerRuntime", "gateModes", "hardErrorProneRuleIds", "qualityBaselinePath", "qualityBaselineSha256", "qualityBaselineRunner", "findingAdapterRunner", "findingAdapters", "thresholds"],
  "properties": {
    "schemaVersion": {"const": 2},
    "standardIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standardVersion", "baselineId", "javaSpecCommit"],
      "properties": {
        "standardVersion": {"const": "0.4.0"},
        "baselineId": {"type": "string", "minLength": 1},
        "javaSpecCommit": {"$ref": "#/$defs/commit"}
      }
    },
    "mode": {"enum": ["strict", "ratchet"]},
    "reactorModules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/reactorModule"}
    },
    "sourceLayoutVerifier": {"$ref": "#/$defs/sourceLayoutRunner"},
    "qualityRunnerRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rubyCommand", "exactVersion"],
      "properties": {
        "rubyCommand": {"const": "ruby"},
        "exactVersion": {"const": "3.4.10"}
      }
    },
    "gateModes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spotless", "checkstyle", "error-prone", "archunit", "pmd", "spotbugs"],
      "properties": {
        "spotless": {"const": "hard"},
        "checkstyle": {"enum": ["hard", "ratchet"]},
        "error-prone": {"const": "hard"},
        "archunit": {"const": "hard"},
        "pmd": {"enum": ["observed", "ratchet"]},
        "spotbugs": {"const": "observed"}
      }
    },
    "hardErrorProneRuleIds": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["CollectionIncompatibleType", "InterruptedExceptionSwallowed", "InterruptedInCatchBlock"]}
    },
    "qualityBaselinePath": {"type": ["string", "null"], "minLength": 1},
    "qualityBaselineSha256": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/sha256"}
      ]
    },
    "qualityBaselineRunner": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/qualityBaselineRunner"}
      ]
    },
    "findingAdapterRunner": {"$ref": "#/$defs/findingAdapterRunner"},
    "findingAdapters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkstyle", "pmd", "spotbugs"],
      "properties": {
        "checkstyle": {"$ref": "#/$defs/checkstyleAdapter"},
        "pmd": {"$ref": "#/$defs/pmdAdapter"},
        "spotbugs": {"$ref": "#/$defs/spotbugsAdapter"}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productionClassLinesReview", "methodLinesReview", "testClassLinesReview", "parameterCountReview", "nestingDepthReview"],
      "properties": {
        "productionClassLinesReview": {"const": 300},
        "methodLinesReview": {"const": 60},
        "testClassLinesReview": {"const": 500},
        "parameterCountReview": {"const": 7},
        "nestingDepthReview": {"const": 4}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "strict"}}},
      "then": {
        "properties": {
          "gateModes": {
            "properties": {
              "checkstyle": {"const": "hard"},
              "pmd": {"const": "observed"}
            }
          },
          "qualityBaselinePath": {"type": "null"},
          "qualityBaselineSha256": {"type": "null"},
          "qualityBaselineRunner": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "gateModes": {
            "properties": {
              "checkstyle": {"const": "ratchet"},
              "pmd": {"const": "ratchet"}
            }
          },
          "qualityBaselinePath": {"$ref": "#/$defs/repositoryPath"},
          "qualityBaselineSha256": {"$ref": "#/$defs/sha256"},
          "qualityBaselineRunner": {"$ref": "#/$defs/qualityBaselineRunner"}
        },
        "required": ["qualityBaselinePath", "qualityBaselineSha256", "qualityBaselineRunner"]
      }
    }
  ],
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "modulePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:\\.|(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\]+(?:/[^/\\\\]+)*)$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\]+(?:/[^/\\\\]+)*$"
    },
    "sourceLayoutRunner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["javaSpecCommit", "relativePath", "sha256"],
      "properties": {
        "javaSpecCommit": {"$ref": "#/$defs/commit"},
        "relativePath": {"const": "scripts/verify_source_layout.rb"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "findingAdapterRunner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["javaSpecCommit", "relativePath", "sha256"],
      "properties": {
        "javaSpecCommit": {"$ref": "#/$defs/commit"},
        "relativePath": {"const": "scripts/normalize_quality_findings.rb"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "qualityBaselineRunner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["javaSpecCommit", "relativePath", "sha256"],
      "properties": {
        "javaSpecCommit": {"$ref": "#/$defs/commit"},
        "relativePath": {"const": "scripts/quality_baseline.rb"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "reactorModule": {
      "oneOf": [
        {"$ref": "#/$defs/sourceModule"},
        {"$ref": "#/$defs/aggregatorModule"}
      ]
    },
    "sourceModule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modulePath", "qualityRole", "sourceSets", "generatedSources", "reports"],
      "properties": {
        "modulePath": {"$ref": "#/$defs/modulePath"},
        "qualityRole": {"const": "source"},
        "sourceSets": {"$ref": "#/$defs/sourceSets"},
        "generatedSources": {"type": "array", "maxItems": 0, "items": {"$ref": "#/$defs/generatedSource"}},
        "reports": {"$ref": "#/$defs/moduleReports"}
      }
    },
    "aggregatorModule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modulePath", "qualityRole"],
      "properties": {
        "modulePath": {"$ref": "#/$defs/modulePath"},
        "qualityRole": {"const": "aggregator"}
      }
    },
    "sourceSets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["main", "test"],
      "properties": {
        "main": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/repositoryPath"}},
        "test": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/repositoryPath"}}
      }
    },
    "moduleReports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkstyle", "pmd", "spotbugs"],
      "properties": {
        "checkstyle": {"const": "target/checkstyle-result.xml"},
        "pmd": {"const": "target/pmd.xml"},
        "spotbugs": {"const": "target/spotbugsXml.xml"}
      }
    },
    "generatedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "version", "rebuild", "outputPath", "provenance", "generatedTreeSha256"],
      "properties": {
        "generator": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "rebuild": {"$ref": "#/$defs/rebuild"},
        "outputPath": {"$ref": "#/$defs/repositoryPath"},
        "provenance": {
          "oneOf": [
            {"$ref": "#/$defs/manifestProvenance"},
            {"$ref": "#/$defs/headerProvenance"}
          ]
        },
        "generatedTreeSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "manifestProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "manifestPath", "manifestSha256"],
      "properties": {
        "type": {"const": "manifest"},
        "manifestPath": {"$ref": "#/$defs/repositoryPath"},
        "manifestSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "headerProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "marker", "markerSha256"],
      "properties": {
        "type": {"const": "header"},
        "marker": {"type": "string", "minLength": 1},
        "markerSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "rebuild": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "argv", "cwd", "environment", "timeoutSeconds", "networkPolicy"],
      "properties": {
        "executable": {"enum": ["./mvnw", "mvnw.cmd"]},
        "argv": {
          "type": "array",
          "minItems": 4,
          "items": {"type": "string", "minLength": 1, "pattern": "^[^;&|<>`$\\r\\n]+$"}
        },
        "cwd": {"$ref": "#/$defs/modulePath"},
        "environment": {"type": "object", "additionalProperties": false, "properties": {}},
        "timeoutSeconds": {"enum": [60, 120, 300, 600]},
        "networkPolicy": {"const": "offline"}
      }
    },
    "checkstyleAdapter": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "rawFormat"],
      "properties": {"schemaVersion": {"const": 1}, "rawFormat": {"const": "checkstyle-xml"}}
    },
    "pmdAdapter": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "rawFormat"],
      "properties": {"schemaVersion": {"const": 1}, "rawFormat": {"const": "pmd-xml"}}
    },
    "spotbugsAdapter": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "rawFormat"],
      "properties": {"schemaVersion": {"const": 1}, "rawFormat": {"const": "spotbugs-xml"}}
    }
  }
}
