{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://java-spec.local/schemas/standard-exception.schema.json",
  "title": "Java 规范例外记录",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "standardVersion", "policyPath", "availability", "exception"],
  "properties": {
    "schemaVersion": {"const": 1},
    "standardVersion": {"const": "0.4.0"},
    "policyPath": {"const": "policies/exception-policy.yaml"},
    "availability": {"const": "prohibited-in-0.4.0"},
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exceptionId", "ruleId", "projectAndModule", "owner", "approver", "createdOn", "expiresOn", "status", "exactScope", "outOfScope", "reason", "risk", "compensatingControls", "evidence", "exitOwner", "exitConditions"],
      "properties": {
        "exceptionId": {"type": "string", "minLength": 1},
        "ruleId": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"},
        "projectAndModule": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "approver": {"type": "string", "minLength": 1},
        "createdOn": {"type": "string", "minLength": 1},
        "expiresOn": {"type": "string", "minLength": 1},
        "status": {"const": "proposed"},
        "exactScope": {"type": "string", "minLength": 1},
        "outOfScope": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "risk": {"type": "string", "minLength": 1},
        "compensatingControls": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "exitOwner": {"type": "string", "minLength": 1},
        "exitConditions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
